# BikeChain Environment Configuration Template
# Duplicate this file to .env and configure your local or testnet credentials.

# Network & RPC
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"
LOCAL_RPC_URL="http://127.0.0.1:8545"

# Smart Contract
VITE_BIKECHAIN_CONTRACT_ADDRESS="0x742d35Cc6634C0532925a3b844Bc454e4438f44e"
VITE_CHAIN_ID="11155111"

# Backend & Database (Phase 2)
PORT=5000
MONGODB_URI="mongodb://localhost:27017/bikechain"
JWT_SECRET="replace_with_a_secure_jwt_secret_token"

# IPFS / Decentralized Storage (Phase 6)
PINATA_API_KEY="your_pinata_api_key"
PINATA_API_SECRET="your_pinata_api_secret"
